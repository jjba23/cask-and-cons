;;; Typeface configuration for the places that have their own font settings:
;;; fontconfig (the generic sans-serif, serif and monospace aliases) and the
;;; JetBrains IDEs (editor font).  The families come from (cask-and-cons
;;; user-settings); the fonts themselves are installed by the Homebrew module.

(define-module (cask-and-cons fonts)
  #:declarative? #t
  #:use-module (srfi srfi-1)
  #:use-module (ice-9 ftw)
  #:use-module (cask-and-cons prelude)
  #:use-module (cask-and-cons user-settings)
  #:export (fontconfig-dir
            fontconfig-filename
            fontconfig-aliases
            fontconfig-xml
            jetbrains-config-roots
            jetbrains-editor-font-size
            jetbrains-editor-font-xml
            install-fontconfig
            install-jetbrains-fonts))

;;; --- fontconfig ---

(define fontconfig-dir
  (make-parameter (format #f "~a/fontconfig"
                          (let ((xdg (getenv "XDG_CONFIG_HOME")))
                            (if (and xdg (not (string=? xdg "")))
                              xdg
                              (format #f "~a/.config"
                                      (or (getenv "HOME") "/tmp")))))))

(define fontconfig-filename
  (make-parameter "fonts.conf"))

;;; Generic family -> the family that should win for it.
(define fontconfig-aliases
  (make-parameter
   (list (cons "sans-serif" font-sans)
         (cons "serif" font-serif)
         (cons "monospace" font-mono))))

(define (fontconfig-xml)
  "Return the fonts.conf text: each generic family is aliased to its family,
which is put first so it is preferred over every other candidate."
  (string-append
   "<?xml version=\"1.0\"?>\n"
   "<!DOCTYPE fontconfig SYSTEM \"urn:fontconfig:fonts.dtd\">\n"
   "<!-- auto-generated by cask-and-cons, DO NOT EDIT! -->\n"
   "<fontconfig>\n"
   (string-concatenate
    (map (lambda (alias)
           (format #f
                   "  <alias binding=\"same\">\n    <family>~a</family>\n    <prefer><family>~a</family></prefer>\n  </alias>\n"
                   (car alias) (cdr alias)))
         (fontconfig-aliases)))
   "</fontconfig>\n"))

(define (install-fontconfig)
  (log-info "Installing fontconfig configuration")
  (load-local-overrides '(cask-and-cons fonts) 'fonts-settings)
  (system* "mkdir" "-p" (fontconfig-dir))
  (install-config-file! #:name (fontconfig-filename)
                        #:dir (fontconfig-dir)
                        #:contents (fontconfig-xml))
  (log-success "Installed fontconfig configuration"))

;;; --- JetBrains IDEs ---

;;; Directories holding one sub-directory per installed IDE version, such as
;;; IntelliJIdea2025.2.
(define jetbrains-config-roots
  (make-parameter
   (let ((home (or (getenv "HOME") "/tmp")))
     (list (format #f "~a/Library/Application Support/JetBrains" home)
           (format #f "~a/.config/JetBrains" home)))))

(define jetbrains-editor-font-size
  (make-parameter 13))

(define (jetbrains-editor-font-xml)
  "Return the options/editor-font.xml text for the editor font."
  (string-append
   "<application>\n"
   "  <component name=\"DefaultFont\">\n"
   (format #f "    <option name=\"FONT_FAMILY\" value=\"~a\" />\n" font-mono)
   (format #f "    <option name=\"FONT_SIZE\" value=\"~a\" />\n"
           (jetbrains-editor-font-size))
   "  </component>\n"
   "</application>\n"))

(define (jetbrains-ide-dirs)
  "Return the configuration directories of every installed JetBrains IDE."
  (append-map
   (lambda (root)
     (if (file-exists? root)
       (map (lambda (name) (string-append root "/" name))
            (filter (lambda (name)
                      (and (not (string-prefix? "." name))
                        (eq? 'directory
                             (stat:type (stat (string-append root "/" name))))))
                    (scandir root)))
       '()))
   (jetbrains-config-roots)))

(define (install-jetbrains-fonts)
  "Write the editor font into every installed JetBrains IDE.  Restart the IDE
for it to take effect; the IDE rewrites this file on exit if it is running."
  (log-info "Installing JetBrains editor font")
  (load-local-overrides '(cask-and-cons fonts) 'fonts-settings)
  (let ((dirs (jetbrains-ide-dirs)))
    (if (null? dirs)
      (log-warning "No JetBrains IDE configuration found, skipping")
      (for-each (lambda (dir)
                  (let ((options (string-append dir "/options")))
                    (system* "mkdir" "-p" options)
                    (install-config-file! #:name "editor-font.xml"
                                          #:dir options
                                          #:contents (jetbrains-editor-font-xml))))
                dirs)))
  (log-success "Installed JetBrains editor font"))
