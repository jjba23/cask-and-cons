(define-module (cask-and-cons emacs)
  #:declarative? #t
  #:use-module (ice-9 pretty-print)
  #:use-module (cask-and-cons prelude)
  #:use-module (cask-and-cons user-settings)
  #:export (emacs-bridge-forms install-emacs-bridge emacs-bridge-dir
                               emacs-bridge-filename))

;; ELisp is data to Scheme: the bridge is a quoted list of ELisp forms.
;; Both are Lisps, so the reader and printer round-trip it unchanged
;; ('ayu-dark reads as (quote ayu-dark) and prints back as 'ayu-dark).
(define emacs-bridge-forms
  `((setopt heks/font-mono
            "Intel One Mono"
            heks/font-sans
            "Lucida Sans"
            heks/font-serif
            "Baskerville"
            heks/theme
            ,(list 'quote (theme-emacs-theme global-theme))
            heks/clone-dir
            "~/Hacking/heks-emacs"
            heks/notes-dir
            ,notes-directory)))

(define emacs-bridge-dir
  (make-parameter (format #f "~a/.emacs.d"
                          (or (getenv "HOME") "/tmp"))))

(define emacs-bridge-filename
  (make-parameter "cask-and-cons-bridge.el"))

(define (mk-elisp-lines forms)
  "Serialize @var{forms}, a list of ELisp forms, into ELisp source text."
  (with-output-to-string (lambda ()
                           (for-each (lambda (form)
                                       (pretty-print form
                                                     #:per-line-prefix ""
                                                     #:width 120)
                                       (newline)) forms))))

(define (mk-emacs-bridge forms)
  (string-append
   ";; cask-and-cons-bridge.el --- Bridge to Heks Emacs  -*- lexical-binding: t -*-
"
   ";; Generated by cask-and-cons (caco install-emacs-bridge); do not edit.
"
   (mk-elisp-lines forms)))

(define (install-emacs-bridge)
  (log-info "Installing Emacs bridge")
  (load-local-overrides '(cask-and-cons emacs)
                        'emacs-settings)
  (install-config-file! #:name (emacs-bridge-filename)
                        #:dir (emacs-bridge-dir)
                        #:contents (mk-emacs-bridge emacs-bridge-forms))
  (log-success "Installed Emacs bridge"))
